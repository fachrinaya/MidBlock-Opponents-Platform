# Optional live data connection. Never commit your real .env.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=football_analytics
DB_USER=midblock
DB_PASSWORD=
# Optional alternative: DATABASE_URL=postgresql+psycopg2://...

# Optional Bedrock access: configure AWS_PROFILE through your normal AWS setup,
# or supply AWS_BEARER_TOKEN_BEDROCK. No credentials are needed for demo/serve.
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=14000
AWS_BEARER_TOKEN_BEDROCK=

# Optional tunnel helper. Use your personal fachrinaya key, never the tvl key.
SSH_HOST=
SSH_USER=ubuntu
SSH_KEY_FILE=~/.ssh/id_ed25519
LOCAL_DB_PORT=5433
REMOTE_DB_PORT=5432
# PDF_CHROMIUM_PATH=/path/to/chrome-or-chromium
